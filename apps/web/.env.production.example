# Set this in Vercel Project Settings -> Environment Variables.
# Use the HTTPS origin of the deployed āprən gateway, without a trailing /api.
VITE_GATEWAY_URL=https://your-deployed-gateway.example.com

# Optional direct service URLs. Leave unset to route through the gateway.
# VITE_IDENTITY_URL=https://your-identity-service.example.com
# VITE_WALLET_URL=https://your-wallet-service.example.com
# VITE_ASSET_API=https://your-assets-service.example.com
# VITE_MARKET_URL=https://your-market-service.example.com
# VITE_INTELLIGENCE_URL=https://your-intelligence-service.example.com
# VITE_TRADE_URL=https://your-trade-service.example.com
