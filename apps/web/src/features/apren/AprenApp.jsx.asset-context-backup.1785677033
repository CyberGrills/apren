function factorsFor(asset) {
  const factors = [];
  factors.push(
    asset.freshness >= 90
      ? `${asset.freshness}% freshness — near peak quality`
      : `${asset.freshness}% freshness`
  );
  factors.push(
    asset.demand === "High" || asset.demand === "Increasing"
      ? `${asset.demand} demand nearby is pushing value up`
      : `Demand is ${asset.demand.toLowerCase()} — price is stable`
  );
  factors.push(
    asset.change !== 0
      ? `Price moved ${asset.change > 0 ? "+" : ""}${asset.change}% this week`
      : "Price has held steady this week"
  );
  factors.push(`Journey: ${asset.journey.join(" → ")}`);
  return factors;
}

/* ---------- shared bits ---------- */

function TrendIcon({ trend }) {
  if (trend === "up") return <TrendingUp size={15} strokeWidth={2} />;
  if (trend === "down") return <TrendingDown size={15} strokeWidth={2} />;
  return <Minus size={15} strokeWidth={2} />;
}

function FreshnessRing({ value, size = 48 }) {
  const r = 19;
  const c = 2 * Math.PI * r;
  const offset = c - (value / 100) * c;
  return (
    <svg width={size} height={size} viewBox="0 0 48 48">
      <circle cx="24" cy="24" r={r} fill="none" stroke="var(--line)" strokeWidth="3" />
      <circle cx="24" cy="24" r={r} fill="none" stroke="var(--basil)" strokeWidth="3"
        strokeDasharray={c} strokeDashoffset={offset} strokeLinecap="round" transform="rotate(-90 24 24)" />
      <text x="24" y="27" textAnchor="middle" className="ring-text">{value}</text>
    </svg>
  );
}

function SchwaStamp({ size = 56 }) {
  return (
    <div className="stamp" style={{ width: size, height: size }}>
      <svg viewBox="0 0 100 100" width="100%" height="100%">
        <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" strokeWidth="2" strokeDasharray="2 4" />
        <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" strokeWidth="1.2" />
        <text x="50" y="60" textAnchor="middle" className="stamp-glyph">ə</text>
      </svg>
    </div>
  );
}

function Sparkline({ points, positive, w = 64, h = 24 }) {
  const min = Math.min(...points), max = Math.max(...points);
  const range = max - min || 1;
  const coords = points.map((p, i) => {
    const x = (i / (points.length - 1)) * w;
    const y = h - ((p - min) / range) * h;
    return `${x},${y}`;
  }).join(" ");
  return (
    <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`}>
      <polyline points={coords} fill="none" stroke={positive ? "var(--basil)" : "var(--brick)"} strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" />
    </svg>
  );
}

function BackButton({ onClick, label }) {
  return (
    <button className="back-btn" onClick={onClick}>
      <ArrowLeft size={14} /> {label}
    </button>
  );
}

function WhyPanel({ asset }) {
  const [open, setOpen] = useState(false);
  return (
    <div className="why-panel">
      <button className="why-toggle" onClick={() => setOpen(!open)}>
        Why this price <ChevronDown size={13} className={open ? "chev open" : "chev"} />
      </button>
      {open && (
        <ul className="why-list">
          {factorsFor(asset).map((f) => <li key={f}>{f}</li>)}
        </ul>
      )}
    </div>
  );
}

function NavBar({ active, onNavigate }) {
  const nav = [
    { id: "wallet", label: "Wallet", icon: Wallet },
    { id: "intelligence", label: "Intelligence", icon: Sparkles },
    { id: "market", label: "Market", icon: TrendingUp },
    { id: "exchange", label: "Exchange", icon: ArrowRight },
    { id: "kitchens", label: "Kitchens", icon: ChefHat },
  ];
  return (
    <div className="navbar">
      {nav.map(({ id, label, icon: Icon }) => (
        <button key={id} className={`navbtn ${active === id ? "active" : ""}`} onClick={() => onNavigate(id)}>
          <Icon size={18} strokeWidth={active === id ? 2.4 : 1.8} />
          {label}
        </button>
      ))}
    </div>
  );
}

