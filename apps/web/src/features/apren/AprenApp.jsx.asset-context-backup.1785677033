/* ---------- market screen ---------- */

function MarketScreen({ goTo }) {
  const [category, setCategory] = useState("All");
  const [query, setQuery] = useState("");

  const filtered = useMemo(() => {
    return assets.filter((l) => {
      const inCat = category === "All" || l.category === category;
      const inQuery = l.name.toLowerCase().includes(query.toLowerCase());
      return inCat && inQuery;
    });
  }, [category, query]);

  return (
    <div className="scroll">
      <div className="topbar">
        <div>
          <div className="eyebrow">Food market</div>
          <div className="title">Discover value</div>
        </div>
      </div>

      <div className="search-row">
        <div className="search-box">
          <Search size={15} color="var(--ink-soft)" />
          <input placeholder="Search rice, tomatoes, meals..." value={query} onChange={(e) => setQuery(e.target.value)} />
        </div>
        <div className="filter-btn"><SlidersHorizontal size={16} /></div>
      </div>

      <div className="chips">
        {categories.map((c) => (
          <button key={c} className={`chip ${category === c ? "active" : ""}`} onClick={() => setCategory(c)}>{c}</button>
        ))}
      </div>

      {filtered.length === 0 ? (
        <div className="empty">
          <Search size={22} />
          <div className="empty-title">No assets match</div>
          <div className="empty-body">Try a different category or search term.</div>
        </div>
      ) : (
        <>
          <div className="result-count">{filtered.length} asset{filtered.length !== 1 ? "s" : ""} · sorted by demand</div>
          {filtered.map((l) => (
            <div className="listing" key={l.name} onClick={() => goTo("assetDetail", { asset: l, backTo: "market" })}>
              <div className="listing-main">
                <div className="listing-name">{l.name}</div>
                <div className="listing-source">{l.kitchen} · {l.origin}</div>
                <div className="listing-tags">
                  <span className={`tag ${demandStyle[l.demand]}`}>{l.demand}</span>
                  <span className="tag fresh">{l.freshness}% fresh</span>
                </div>
              </div>
              <div className="listing-side">
                <Sparkline points={l.history} positive={l.change >= 0} />
                <div className="listing-price">ə {l.price}</div>
                <div className={`listing-change ${l.change > 0 ? "pos" : l.change < 0 ? "neg" : "zero"}`}>
                  {l.change > 0 && <ArrowUpRight size={11} />}
                  {l.change < 0 && <ArrowDownRight size={11} />}
                  {l.change === 0 ? "steady" : `${l.change > 0 ? "+" : ""}${l.change}%`}
                </div>
              </div>
            </div>
          ))}
        </>
      )}
    </div>
  );
}

/* ---------- exchange screen ---------- */

function AssetField({ label, asset, amount, onAmount, editable, open, onToggle, onPick, exclude }) {
  return (
    <div className="swap-field">
      <div className="swap-field-label">{label}</div>
      <div className="swap-field-row">
        <input
          type="number" min="0" step="0.1" className="swap-amount"
          value={amount} readOnly={!editable}
          onChange={(e) => editable && onAmount(Math.max(0, Number(e.target.value)))}
        />
        <button className="swap-asset-btn" onClick={onToggle}>
          {asset.name} <ArrowRight size={12} className="swap-chevron" />
        </button>
      </div>
      {open && (
        <div className="swap-options">
          {assets.filter((a) => a.name !== exclude).map((a) => (
            <button key={a.name} className="swap-option" onClick={() => onPick(a)}>
              {a.name} <span>ə {a.price}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

function ExchangeScreen({ presetAsset }) {
  const [fromAsset, setFromAsset] = useState(assets[2]);
  const [toAsset, setToAsset] = useState(presetAsset || assets[4]);
  const [fromAmt, setFromAmt] = useState(1);
  const [openField, setOpenField] = useState(null);
  const [step, setStep] = useState("form");
  const [log, setLog] = useState(exchangeHistorySeed);

  const toAmt = useMemo(() => {
    const val = (fromAmt * fromAsset.price) / toAsset.price;
    return Math.round(val * 10) / 10;
  }, [fromAmt, fromAsset, toAsset]);

  const rate = Math.round((fromAsset.price / toAsset.price) * 100) / 100;

  function swapDirection() {
    setFromAsset(toAsset);
    setToAsset(fromAsset);
  }

  function confirm() {
    setLog([{ from: fromAsset.name, to: toAsset.name, fromAmt, toAmt, when: "Just now" }, ...log]);
    setStep("done");
  }

  if (step === "review") {
    return (
      <div className="scroll">
        <div className="topbar">
          <div>
            <div className="eyebrow">Confirm</div>
            <div className="title">Review exchange</div>
          </div>
        </div>
        <div className="swap-card">
          <div className="review-row"><span>You give</span><strong>{fromAmt} × {fromAsset.name}</strong></div>
          <div className="review-row"><span>You receive</span><strong>{toAmt} × {toAsset.name}</strong></div>
          <div className="review-row"><span>Rate</span><strong>1 {fromAsset.name} ≈ {rate} {toAsset.name}</strong></div>
          <div className="review-row"><span>Fee</span><strong>0 ə · community exchange</strong></div>
          <button className="swap-confirm" onClick={confirm}>Confirm exchange</button>
          <button className="swap-cancel" onClick={() => setStep("form")}>Back</button>
        </div>
      </div>
    );
  }

  if (step === "done") {
    return (
      <div className="scroll">
        <div className="topbar">
          <div>
            <div className="eyebrow">Exchange</div>
            <div className="title">Done</div>
          </div>
        </div>
        <div className="receipt">
          <div className="receipt-check"><Check size={20} /></div>
          <div className="receipt-title">Exchange complete</div>
          <div className="receipt-body">{fromAmt} × {fromAsset.name} for {toAmt} × {toAsset.name}</div>
          <button className="swap-confirm" onClick={() => setStep("form")}>Make another exchange</button>
        </div>
        <div className="section-head"><div className="section-title">Recent exchanges</div></div>
        <div className="kitchen-list">
          {log.map((h, i) => (
            <div className="kitchen-row" key={i}>
              <div className="kitchen-avatar hist"><ArrowRight size={14} /></div>
              <div style={{ flex: 1 }}>
                <div className="kitchen-name">{h.fromAmt}× {h.from} → {h.toAmt}× {h.to}</div>
                <div className="kitchen-note">{h.when}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }

  return (
    <div className="scroll">
      <div className="topbar">
        <div>
          <div className="eyebrow">Food exchange</div>
          <div className="title">Trade value</div>
        </div>
      </div>

      <div className="swap-card">
        <AssetField
          label="You give" asset={fromAsset} amount={fromAmt} onAmount={setFromAmt} editable
          open={openField === "from"} onToggle={() => setOpenField(openField === "from" ? null : "from")}
          onPick={(a) => { setFromAsset(a); setOpenField(null); }} exclude={toAsset.name}
        />
        <button className="swap-divider" onClick={swapDirection} aria-label="Reverse exchange">
          <ArrowRight size={16} style={{ transform: "rotate(90deg)" }} />
        </button>
        <AssetField
          label="You receive" asset={toAsset} amount={toAmt} onAmount={() => {}} editable={false}
          open={openField === "to"} onToggle={() => setOpenField(openField === "to" ? null : "to")}
          onPick={(a) => { setToAsset(a); setOpenField(null); }} exclude={fromAsset.name}
        />
        <div className="swap-rate">1 {fromAsset.name} ≈ {rate} {toAsset.name}</div>
        <button className="swap-confirm" disabled={fromAmt <= 0} onClick={() => fromAmt > 0 && setStep("review")}>
          {fromAmt > 0 ? "Review exchange" : "Enter an amount"}
        </button>
      </div>

      <div className="section-head"><div className="section-title">Recent exchanges</div></div>
      <div className="kitchen-list">
        {log.map((h, i) => (
          <div className="kitchen-row" key={i}>
            <div className="kitchen-avatar hist"><ArrowRight size={14} /></div>
            <div style={{ flex: 1 }}>
              <div className="kitchen-name">{h.fromAmt}× {h.from} → {h.toAmt}× {h.to}</div>
              <div className="kitchen-note">{h.when}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

/* ---------- intelligence screen ---------- */

function IntelligenceScreen({ goTo }) {
  const top = assets.find((a) => a.name === "Chicken Rice Bowl");
  const more = assets.filter((a) => recommendationReasons[a.name] && a.name !== top.name);

  return (
    <div className="scroll">
      <div className="topbar">
        <div>
          <div className="eyebrow">Food intelligence</div>
          <div className="title">Ask āprən</div>
        </div>
      </div>

      <div className="ask-box">
        <input className="ask-input" placeholder="What should I eat tonight?" readOnly />
        <button className="ask-send" aria-label="Ask"><ArrowRight size={15} /></button>
      </div>
      <div className="chips" style={{ marginBottom: 22 }}>
        {quickPrompts.map((p) => <button className="chip" key={p}>{p}</button>)}
      </div>

      <div className="flow-strip">
        {decisionFlow.map((step, i) => (
          <React.Fragment key={step}>
            <div className="flow-step">{step}</div>
            {i < decisionFlow.length - 1 && <div className="flow-line" />}
          </React.Fragment>
        ))}
      </div>

      <div className="section-head"><div className="section-title">Today's top pick</div></div>
      <div className="pick-card">
        <div className="pick-top" onClick={() => goTo("assetDetail", { asset: top, backTo: "intelligence" })}>
          <div>
            <div className="pick-name">{top.name}</div>
            <div className="asset-kitchen">{top.kitchen} · {top.origin}</div>
          </div>
          <FreshnessRing value={top.freshness} />
        </div>
        <div className="pick-why">{recommendationReasons[top.name]}</div>
        <WhyExpand asset={top} light />
        <div className="pick-bottom">
          <div className="asset-value">ə {top.price}</div>
          <span className={`tag ${demandStyle[top.demand]}`}>{top.demand}</span>
        </div>
      </div>

      <div className="section-head"><div className="section-title">More recommendations</div></div>
      <div className="asset-scroll">
        {more.map((a) => (
          <div className="asset-card" key={a.name} onClick={() => goTo("assetDetail", { asset: a, backTo: "intelligence" })}>
            <div className="asset-top">
              <div>
                <div className="asset-name">{a.name}</div>
                <div className="asset-kitchen">{a.kitchen}</div>
              </div>
              <FreshnessRing value={a.freshness} />
            </div>
            <div className="pick-why small">{recommendationReasons[a.name]}</div>
            <div className="asset-value">ə {a.price}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

function WhyExpand({ asset, light }) {
  const [open, setOpen] = useState(false);
  return (
    <div className={`why-panel ${light ? "on-dark" : ""}`}>
      <button className="why-toggle" onClick={() => setOpen(!open)}>
        See why <ChevronDown size={13} className={open ? "chev open" : "chev"} />
      </button>
      {open && (
        <ul className="why-list">
          {factorsFor(asset).map((f) => <li key={f}>{f}</li>)}
        </ul>
      )}
    </div>
  );
}

/* ---------- kitchens screen ---------- */

function KitchensScreen({ goTo }) {
  return (
    <div className="scroll">
      <div className="topbar">
        <div>
          <div className="eyebrow">Kitchens</div>
          <div className="title">Food creators</div>
        </div>
      </div>

      {kitchens.map((k) => (
        <div className="kitchen-card" key={k.name} onClick={() => goTo("kitchenDetail", { kitchen: k, backTo: "kitchens" })}>
          <div className="kitchen-card-top">
            <div className="kitchen-avatar lg">{k.initial}</div>
            <div style={{ flex: 1 }}>
              <div className="kitchen-name">{k.name}</div>
              <div className="kitchen-tagline">{k.tagline}</div>
            </div>
            <div className={`pulse-icon ${k.demand}`}><TrendIcon trend={k.demand} /></div>
          </div>

          <div className="kitchen-specialties">
            {k.specialties.map((s) => <span className="tag flat" key={s}>{s}</span>)}
          </div>

          <div className="kitchen-signal">
            <span>{k.signal}</span>
            <span className="kitchen-capacity">{k.capacity}</span>
          </div>

          {k.assetNames.length > 0 && (
            <div className="kitchen-assets">
              {k.assetNames.map((name) => {
                const a = assets.find((x) => x.name === name);
                if (!a) return null;
                return (
                  <button className="kitchen-asset-chip" key={name}
                    onClick={(e) => { e.stopPropagation(); goTo("assetDetail", { asset: a, backTo: "kitchens" }); }}>
                    {name} <span>ə {a.price}</span>
                  </button>
                );
              })}
            </div>
          )}
        </div>
      ))}
    </div>
  );
}

/* ---------- asset detail screen ---------- */

function AssetDetailScreen({ asset, backTo, goTo }) {
  if (!asset) return null;
  return (
    <div className="scroll">
      <BackButton onClick={() => goTo(backTo)} label={`Back to ${backTo}`} />

      <div className="detail-head">
        <div>
          <div className="eyebrow">Food asset</div>
          <div className="title">{asset.name}</div>
          <div className="asset-kitchen">{asset.kitchen} · {asset.origin}</div>
        </div>
        <FreshnessRing value={asset.freshness} size={56} />
      </div>

      <div className="detail-stats">
        <div className="stat-box">
          <div className="stat-label">Current value</div>
          <div className="stat-value">ə {asset.price}</div>
        </div>
        <div className="stat-box">
          <div className="stat-label">This week</div>
          <div className={`stat-value ${asset.change >= 0 ? "pos" : "neg"}`}>
            {asset.change === 0 ? "steady" : `${asset.change > 0 ? "+" : ""}${asset.change}%`}
          </div>
        </div>
        <div className="stat-box">
          <div className="stat-label">Demand</div>
          <div className="stat-value">{asset.demand}</div>
        </div>
      </div>

      <WhyPanel asset={asset} />

      <div className="section-head"><div className="section-title">Price history</div></div>
      <div className="chart-card">
        <Sparkline points={asset.history} positive={asset.change >= 0} w={360} h={80} />
      </div>

      <div className="section-head"><div className="section-title">Journey</div></div>
      <div className="asset-journey lg">
        {asset.journey.map((step, i) => (
          <React.Fragment key={step}>
            <span>{step}</span>
            {i < asset.journey.length - 1 && <ArrowRight size={12} />}
          </React.Fragment>
        ))}
      </div>

      <div className="log-list">
        {asset.log.map((entry, i) => (
          <div className="log-row" key={i}>
            <div className="log-dot" />
            <div style={{ flex: 1 }}>
              <div className="log-label">{entry.label}</div>
              <div className="log-detail">{entry.detail}</div>
            </div>
            <div className="log-date">{entry.date}</div>
          </div>
        ))}
      </div>

      <button className="swap-confirm" style={{ marginTop: 20 }} onClick={() => goTo("exchange", { trade: asset })}>
        Trade this asset
      </button>
    </div>
  );
}

/* ---------- kitchen detail screen ---------- */

function KitchenDetailScreen({ kitchen, backTo, goTo }) {
  const [supported, setSupported] = useState(false);
  if (!kitchen) return null;
  const kitchenAssets = kitchen.assetNames.map((n) => assets.find((a) => a.name === n)).filter(Boolean);

  return (
    <div className="scroll">
      <BackButton onClick={() => goTo(backTo)} label={`Back to ${backTo}`} />

      <div className="detail-head">
        <div className="kitchen-avatar lg">{kitchen.initial}</div>
        <div style={{ flex: 1 }}>
          <div className="title">{kitchen.name}</div>
          <div className="asset-kitchen">{kitchen.tagline}</div>
        </div>
        <div className={`pulse-icon ${kitchen.demand}`}><TrendIcon trend={kitchen.demand} /></div>
      </div>

      <div className="kitchen-specialties">
        {kitchen.specialties.map((s) => <span className="tag flat" key={s}>{s}</span>)}
      </div>

      <div className="detail-stats">
        <div className="stat-box">
          <div className="stat-label">Capacity</div>
          <div className="stat-value">{kitchen.capacity}</div>
        </div>
        <div className="stat-box">
          <div className="stat-label">Signal</div>
          <div className="stat-value small">{kitchen.signal}</div>
        </div>
      </div>

      {kitchenAssets.length > 0 && (
        <>
          <div className="section-head"><div className="section-title">Food assets</div></div>
          <div className="asset-scroll">
            {kitchenAssets.map((a) => (
              <div className="asset-card" key={a.name} onClick={() => goTo("assetDetail", { asset: a, backTo: "kitchenDetail" })}>
                <div className="asset-top">
                  <div>
                    <div className="asset-name">{a.name}</div>
                    <div className="asset-kitchen">{a.freshness}% fresh</div>
                  </div>
                  <FreshnessRing value={a.freshness} />
                </div>
                <div className="asset-value">ə {a.price}</div>
              </div>
            ))}
          </div>
        </>
      )}

      <div className="section-head"><div className="section-title">Production history</div></div>
      <div className="log-list">
        {kitchen.log.map((entry, i) => (
          <div className="log-row" key={i}>
            <div className="log-dot" />
            <div style={{ flex: 1 }}>
              <div className="log-label">{entry.label}</div>
              <div className="log-detail">{entry.detail}</div>
            </div>
            <div className="log-date">{entry.date}</div>
          </div>
        ))}
      </div>

      {supported ? (
        <div className="supported-note"><Check size={14} /> You supported {kitchen.name} — thanks for contributing.</div>
      ) : (
        <button className="swap-confirm" style={{ marginTop: 20 }} onClick={() => setSupported(true)}>
          Support this kitchen
        </button>
      )}
    </div>
  );
}

/* ---------- rewards screen ---------- */

function RewardsScreen({ backTo, goTo }) {
  return (
    <div className="scroll">
      <BackButton onClick={() => goTo(backTo)} label={`Back to ${backTo}`} />
      <div className="eyebrow">Contribution economy</div>
      <div className="title" style={{ marginBottom: 4 }}>How you earn ə</div>
      <div className="asset-kitchen" style={{ marginBottom: 18 }}>42 ə balance · +3 ə this week</div>

      <div className="section-head"><div className="section-title">Ways to earn</div></div>
      <div className="kitchen-list">
        {earnWays.map(({ label, detail, range, icon: Icon }) => (
          <div className="kitchen-row" key={label}>
            <div className="kitchen-avatar earn"><Icon size={16} /></div>
            <div style={{ flex: 1 }}>
              <div className="kitchen-name">{label}</div>
              <div className="kitchen-note">{detail}</div>
            </div>
            <div className="earn-range">{range}</div>
          </div>
        ))}
      </div>

      <div className="section-head"><div className="section-title">Contribution breakdown</div></div>
      <div className="breakdown-card">
        {contributionBreakdown.map((b) => (
          <div className="breakdown-row" key={b.label}>
            <div className="breakdown-label">{b.label}</div>
            <div className="breakdown-track"><div className="breakdown-fill" style={{ width: `${b.pct}%` }} /></div>
            <div className="breakdown-pct">{b.pct}%</div>
          </div>
        ))}
      </div>

      <div className="section-head"><div className="section-title">Recent rewards</div></div>
      <div className="kitchen-list">
        {rewardHistory.map((r, i) => (
          <div className="kitchen-row" key={i}>
            <div className="kitchen-avatar earn"><Sparkles size={14} /></div>
            <div style={{ flex: 1 }}>
              <div className="kitchen-name">{r.label}</div>
              <div className="kitchen-note">{r.date}</div>
            </div>
            <div className="earn-range pos">+{r.amount} ə</div>
          </div>
        ))}
      </div>
    </div>
  );
}

/* ---------- app shell ---------- */

export default function AprenApp() {
  const [screen, setScreen] = useState("wallet");
  const [selectedAsset, setSelectedAsset] = useState(null);
  const [selectedKitchen, setSelectedKitchen] = useState(null);
  const [backTo, setBackTo] = useState("wallet");
  const [tradeTarget, setTradeTarget] = useState(null);

  function goTo(id, opts = {}) {
    if (opts.asset) setSelectedAsset(opts.asset);
    if (opts.kitchen) setSelectedKitchen(opts.kitchen);
    setBackTo(opts.backTo || "wallet");
    setTradeTarget(opts.trade || null);
    setScreen(id);
  }

  const navActive = ["wallet", "intelligence", "market", "exchange", "kitchens"].includes(screen) ? screen : "";

  return (
    <div className="shell">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,500&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

        .shell {
          --paper: #F7F2E6; --card: #FFFDF8; --ink: #241F18; --ink-soft: #7A7161; --line: #E1D6B8;
          --basil: #3F6B4A; --basil-deep: #2B4A33; --basil-bg: #E4EDDF;
          --brick: #A8432C; --brick-bg: #F3E2D9; --wheat: #C99A2E; --wheat-bg: #F7EACB;
          font-family: 'Inter', sans-serif; background: var(--paper); color: var(--ink);
          max-width: 440px; margin: 0 auto; border: 1px solid var(--line); border-radius: 20px;
          overflow: hidden; box-sizing: border-box; position: relative;
        }
        .shell * { box-sizing: border-box; }
        .scroll { padding: 20px 20px 88px; min-height: 640px; }

        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
        .eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--ink-soft); text-transform: uppercase; }
        .bell { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--ink); flex-shrink: 0; background:none; cursor:pointer; }

        .notification-panel {
          position:relative;
          margin:12px 0;
          padding:14px;
          border:1px solid var(--line);
          border-radius:16px;
          background:var(--surface);
        }

        .notification-item {
          padding:10px 0;
          border-bottom:1px solid var(--line);
          font-size:13px;
        }

        .title { font-family: 'Fraunces', serif; font-style: italic; font-size: 26px; font-weight: 500; }

        .greeting { font-family: 'Fraunces', serif; font-style: italic; font-size: 26px; font-weight: 500; margin: 0 0 14px; line-height: 1.25; }

        .brief { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 14px 16px; margin-bottom: 18px; }
        .brief-row { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; padding: 7px 0; border-bottom: 1px solid var(--line); }
        .brief-row:last-child { border-bottom: none; }
        .brief-row svg { flex-shrink: 0; margin-top: 2px; color: var(--basil); }
        .brief-row span { color: var(--ink); line-height: 1.4; }

        .wallet-card { display: block; text-align: left; width: 100%; position: relative; background: var(--basil-deep); color: #F3EEDC; border: none; border-radius: 16px; padding: 20px; margin-bottom: 22px; overflow: hidden; cursor: pointer; }
        .wallet-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.75; }
        .wallet-balance { font-family: 'IBM Plex Mono', monospace; font-size: 46px; font-weight: 500; margin: 6px 0 2px; display: flex; align-items: baseline; gap: 6px; }
        .wallet-balance .unit { font-size: 22px; opacity: 0.8; }
        .wallet-sub { font-size: 12.5px; opacity: 0.85; }
        .stamp { position: absolute; top: 14px; right: 14px; color: #F3EEDC; opacity: 0.9; }
        .stamp-glyph { font-family: 'Fraunces', serif; font-style: italic; font-size: 34px; fill: currentColor; }

        .section-head { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 12px; }
        .section-title { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 500; }
        .section-link { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft); display: flex; align-items: center; gap: 3px; background: none; border: none; cursor: pointer; padding: 0; }

        .asset-scroll { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; margin: 0 -20px 24px; padding-left: 20px; padding-right: 20px; }
        .asset-scroll::-webkit-scrollbar { display: none; }
        .asset-card { flex: 0 0 210px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px; cursor: pointer; }
        .asset-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
        .asset-name { font-size: 14px; font-weight: 500; line-height: 1.3; }
        .asset-kitchen { font-size: 11.5px; color: var(--ink-soft); margin-top: 2px; }
        .ring-text { font-family: 'IBM Plex Mono', monospace; font-size: 11px; fill: var(--ink); }
        .asset-journey { display: flex; align-items: center; gap: 4px; margin-top: 12px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--ink-soft); }
        .asset-journey.lg { font-size: 12px; margin: 0 0 18px; }
        .asset-journey svg { color: var(--ink-soft); }
        .asset-value { font-family: 'IBM Plex Mono', monospace; font-size: 15px; font-weight: 500; margin-top: 10px; color: var(--basil-deep); }

        .kitchen-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); cursor: pointer; }
        .kitchen-row:last-child { border-bottom: none; }
        .kitchen-avatar { width: 40px; height: 40px; border-radius: 10px; background: var(--wheat-bg); color: var(--wheat); font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .kitchen-avatar.lg { width: 46px; height: 46px; border-radius: 12px; font-size: 14px; }
        .kitchen-avatar.hist { background: var(--basil-bg); color: var(--basil-deep); }
        .kitchen-avatar.earn { background: var(--basil-bg); color: var(--basil-deep); }
        .kitchen-name { font-size: 14px; font-weight: 500; }
        .kitchen-note { font-size: 12px; color: var(--ink-soft); margin-top: 1px; }
        .kitchen-list { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 4px 16px; margin-bottom: 24px; }
        .kitchen-tagline { font-size: 12px; color: var(--ink-soft); margin-top: 1px; }

        .kitchen-card { border: 1px solid var(--line); background: var(--card); border-radius: 16px; padding: 16px; margin-bottom: 14px; cursor: pointer; }
        .kitchen-card-top { display: flex; align-items: center; gap: 12px; }
        .kitchen-specialties { display: flex; gap: 6px; margin: 12px 0 10px; flex-wrap: wrap; }
        .kitchen-signal { display: flex; justify-content: space-between; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 10px; }
        .kitchen-capacity { color: var(--ink); }
        .kitchen-assets { display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; }
        .kitchen-asset-chip { flex-shrink: 0; display: flex; align-items: center; gap: 6px; font-family: 'Inter'; font-size: 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 7px 10px; color: var(--ink); cursor: pointer; }
        .kitchen-asset-chip span { font-family: 'IBM Plex Mono', monospace; color: var(--basil-deep); }

        .pulse-list { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 4px 16px; margin-bottom: 6px; }
        .pulse-row { display: flex; align-items: center; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); }
        .pulse-row:last-child { border-bottom: none; }
        .pulse-icon { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .pulse-icon.up { background: var(--wheat-bg); color: var(--wheat); }
        .pulse-icon.down { background: var(--brick-bg); color: var(--brick); }
        .pulse-icon.flat { background: var(--line); color: var(--ink-soft); }
        .pulse-label { font-size: 13.5px; font-weight: 500; }
        .pulse-detail { font-size: 12px; color: var(--ink-soft); }

        .search-row { display: flex; gap: 8px; margin-bottom: 14px; }
        .search-box { flex: 1; display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
        .search-box input { border: none; outline: none; background: none; font-family: 'Inter'; font-size: 13.5px; color: var(--ink); width: 100%; }
        .search-box input::placeholder { color: var(--ink-soft); }
        .filter-btn { width: 40px; height: 40px; flex-shrink: 0; border-radius: 12px; border: 1px solid var(--line); background: var(--card); display: flex; align-items: center; justify-content: center; color: var(--ink); }

        .chips { display: flex; gap: 8px; overflow-x: auto; margin: 0 -20px 18px; padding: 0 20px 4px; }
        .chips::-webkit-scrollbar { display: none; }
        .chip { flex-shrink: 0; font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; padding: 7px 13px; border-radius: 20px; border: 1px solid var(--line); background: var(--card); color: var(--ink-soft); cursor: pointer; }
        .chip.active { background: var(--basil-deep); border-color: var(--basil-deep); color: #F3EEDC; }

        .result-count { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft); margin-bottom: 10px; }

        .listing { display: flex; align-items: center; gap: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 13px 14px; margin-bottom: 10px; cursor: pointer; }
        .listing-main { flex: 1; min-width: 0; }
        .listing-name { font-size: 14px; font-weight: 500; }
        .listing-source { font-size: 11.5px; color: var(--ink-soft); margin-top: 2px; }
        .listing-tags { display: flex; gap: 6px; margin-top: 8px; align-items: center; }
        .tag { font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 3px 7px; border-radius: 8px; }
        .tag.hot { background: var(--brick-bg); color: var(--brick); }
        .tag.flat { background: var(--line); color: var(--ink-soft); }
        .tag.cool { background: var(--basil-bg); color: var(--basil-deep); }
        .tag.fresh { background: var(--wheat-bg); color: var(--wheat); }

        .listing-side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex-shrink: 0; }
        .listing-price { font-family: 'IBM Plex Mono', monospace; font-size: 15px; font-weight: 500; }
        .listing-change { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; display: flex; align-items: center; gap: 2px; }
        .listing-change.pos { color: var(--basil); }
        .listing-change.neg { color: var(--brick); }
        .listing-change.zero { color: var(--ink-soft); }

        .swap-card { border: 1px solid var(--line); background: var(--card); border-radius: 16px; padding: 16px; margin-bottom: 24px; position: relative; }
        .swap-field { padding: 10px 0; }
        .swap-field-label { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); margin-bottom: 6px; }
        .swap-field-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .swap-amount { font-family: 'IBM Plex Mono', monospace; font-size: 24px; font-weight: 500; border: none; outline: none; background: none; color: var(--ink); width: 90px; }
        .swap-asset-btn { display: flex; align-items: center; gap: 6px; font-family: 'Inter'; font-size: 13.5px; font-weight: 500; background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: 8px 12px; color: var(--ink); cursor: pointer; }
        .swap-chevron { transform: rotate(90deg); color: var(--ink-soft); }
        .swap-options { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 6px; max-height: 180px; overflow-y: auto; }
        .swap-option { display: flex; justify-content: space-between; font-size: 12.5px; padding: 8px 10px; border-radius: 8px; border: none; background: none; color: var(--ink); text-align: left; cursor: pointer; }
        .swap-option:hover { background: var(--card); }
        .swap-option span { font-family: 'IBM Plex Mono', monospace; color: var(--ink-soft); }
        .swap-divider { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--basil-deep); color: #F3EEDC; border: 3px solid var(--card); margin: -4px auto; position: relative; z-index: 1; cursor: pointer; }
        .swap-rate { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--ink-soft); text-align: center; padding: 12px 0 4px; border-top: 1px solid var(--line); margin-top: 6px; }
        .swap-confirm { width: 100%; margin-top: 12px; background: var(--basil-deep); color: #F3EEDC; border: none; border-radius: 12px; padding: 13px; font-family: 'Inter'; font-size: 14px; font-weight: 600; cursor: pointer; }
        .swap-confirm:disabled { opacity: 0.5; cursor: not-allowed; }
        .swap-cancel { width: 100%; margin-top: 8px; background: none; color: var(--ink-soft); border: none; padding: 10px; font-family: 'Inter'; font-size: 13px; cursor: pointer; }
        .review-row { display: flex; justify-content: space-between; font-size: 13px; padding: 10px 0; border-bottom: 1px solid var(--line); }
        .review-row:last-of-type { border-bottom: none; }
        .review-row span { color: var(--ink-soft); }

        .receipt { text-align: center; padding: 28px 16px; border: 1px solid var(--line); background: var(--card); border-radius: 16px; margin-bottom: 24px; }
        .receipt-check { width: 44px; height: 44px; border-radius: 50%; background: var(--basil-bg); color: var(--basil-deep); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
        .receipt-title { font-family: 'Fraunces', serif; font-size: 17px; margin-bottom: 4px; }
        .receipt-body { font-size: 13px; color: var(--ink-soft); margin-bottom: 18px; }

        .ask-box { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 6px 6px 6px 14px; margin-bottom: 12px; }
        .ask-input { flex: 1; border: none; outline: none; background: none; font-family: 'Fraunces', serif; font-style: italic; font-size: 15px; color: var(--ink); }
        .ask-input::placeholder { color: var(--ink-soft); }
        .ask-send { width: 36px; height: 36px; flex-shrink: 0; border-radius: 10px; border: none; background: var(--basil-deep); color: #F3EEDC; display: flex; align-items: center; justify-content: center; cursor: pointer; }

        .flow-strip { display: flex; align-items: center; margin: 4px 0 24px; }
        .flow-step { font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft); background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 6px 10px; white-space: nowrap; }
        .flow-line { flex: 1; height: 1px; background: var(--line); margin: 0 4px; }

        .pick-card { background: var(--basil-deep); color: #F3EEDC; border-radius: 16px; padding: 16px; margin-bottom: 24px; }
        .pick-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; cursor: pointer; }
        .pick-name { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 500; }
        .pick-card .asset-kitchen { color: #D8E2CE; }
        .pick-card .ring-text { fill: #F3EEDC; }
        .pick-why { font-size: 12.5px; color: #E7EEDD; line-height: 1.4; margin: 10px 0 6px; }
        .pick-why.small { color: var(--ink-soft); margin: 8px 0; }
        .pick-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
        .pick-card .asset-value { color: #F3EEDC; margin-top: 0; }

        .why-panel { margin: 10px 0 4px; }
        .why-panel.on-dark .why-toggle { color: #E7EEDD; border-color: rgba(243,238,220,0.3); }
        .why-toggle { display: flex; align-items: center; gap: 4px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft); background: none; border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; cursor: pointer; }
        .chev { transition: transform 0.15s; }
        .chev.open { transform: rotate(180deg); }
        .why-list { margin: 8px 0 0; padding-left: 18px; font-size: 12.5px; color: var(--ink-soft); line-height: 1.6; }
        .why-panel.on-dark .why-list { color: #E7EEDD; }

        .back-btn { display: flex; align-items: center; gap: 6px; background: none; border: none; color: var(--ink-soft); font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; padding: 0; margin-bottom: 16px; }

        .detail-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
        .detail-stats { display: flex; gap: 8px; margin-bottom: 18px; }
        .stat-box { flex: 1; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
        .stat-label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--ink-soft); text-transform: uppercase; margin-bottom: 4px; }
        .stat-value { font-family: 'IBM Plex Mono', monospace; font-size: 16px; font-weight: 500; }
        .stat-value.small { font-family: 'Inter'; font-size: 12px; font-weight: 500; }
        .stat-value.pos { color: var(--basil-deep); }
        .stat-value.neg { color: var(--brick); }

        .chart-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; margin-bottom: 24px; display: flex; justify-content: center; }

        .log-list { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 4px 16px; margin-bottom: 6px; }
        .log-row { display: flex; align-items: flex-start; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); }
        .log-row:last-child { border-bottom: none; }
        .log-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--basil); margin-top: 5px; flex-shrink: 0; }
        .log-label { font-size: 13px; font-weight: 500; }
        .log-detail { font-size: 12px; color: var(--ink-soft); margin-top: 1px; }
        .log-date { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--ink-soft); white-space: nowrap; }

        .supported-note { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 13px; color: var(--basil-deep); background: var(--basil-bg); border-radius: 12px; padding: 12px 14px; }

        .earn-range { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--ink-soft); white-space: nowrap; }
        .earn-range.pos { color: var(--basil-deep); }

        .breakdown-card { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 16px; margin-bottom: 24px; }
        .breakdown-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
        .breakdown-label { font-size: 12px; width: 92px; flex-shrink: 0; color: var(--ink-soft); }
        .breakdown-track { flex: 1; height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; }
        .breakdown-fill { height: 100%; background: var(--basil); border-radius: 3px; }
        .breakdown-pct { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink); width: 32px; text-align: right; }

        .empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 60px 20px; color: var(--ink-soft); }
        .empty svg { color: var(--basil); }
        .empty-title { font-family: 'Fraunces', serif; font-size: 17px; color: var(--ink); }
        .empty-body { font-size: 13px; }

        .navbar { position: absolute; bottom: 0; left: 0; right: 0; display: flex; background: var(--card); border-top: 1px solid var(--line); padding: 8px 4px 12px; }
        .navbtn { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; background: none; border: none; color: var(--ink-soft); font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; cursor: pointer; padding: 6px 0; }
        .navbtn.active { color: var(--basil-deep); }
      `}</style>

      {screen === "wallet" && <WalletScreen goTo={goTo} />}
      {screen === "market" && <MarketScreen goTo={goTo} />}
      {screen === "intelligence" && <IntelligenceScreen goTo={goTo} />}
      {screen === "exchange" && <ExchangeScreen presetAsset={tradeTarget} />}
      {screen === "kitchens" && <KitchensScreen goTo={goTo} />}
      {screen === "assetDetail" && <AssetDetailScreen asset={selectedAsset} backTo={backTo} goTo={goTo} />}
      {screen === "kitchenDetail" && <KitchenDetailScreen kitchen={selectedKitchen} backTo={backTo} goTo={goTo} />}
      {screen === "rewards" && <RewardsScreen backTo={backTo} goTo={goTo} />}

      <NavBar active={navActive} onNavigate={(id) => goTo(id)} />
    </div>
  );
}