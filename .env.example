NODE_ENV=development
PORT=7077
APP_ORIGIN=http://127.0.0.1:5177
# Google Maps JavaScript browser key; keep blank in source control.
# Use a key restricted by HTTP referrer and API. Never place server secrets here.
VITE_GOOGLE_MAPS_API_KEY=
# OAuth is unavailable until the matching provider credentials are configured.
# Callback URLs use APP_ORIGIN + /api/auth/social/{google|apple}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
SEVEN_PREVIEW_READ_ONLY=false
PAYMENT_MODE=mock
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
