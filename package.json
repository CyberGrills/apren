{
  "name": "7even",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "frontend",
    "backend/platform",
    "packages/contracts",
    "packages/engine"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm run typecheck && npm --workspace @7even/web run build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint frontend/src backend/platform/src packages tests",
    "format": "biome format --write frontend/src backend/platform/src packages tests",
    "test": "node --test --test-isolation=none packages/engine/test/*.test.ts packages/contracts/test/*.test.ts tests/frontend/*.test.ts frontend/src/lib/*.test.ts frontend/src/pages/customer/checkout.test.ts tests/tooling/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env --test --test-isolation=none --test-concurrency=1 tests/integration/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env backend/platform/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env backend/platform/src/seed.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "body-parser": "2.4.0"
  }
}
