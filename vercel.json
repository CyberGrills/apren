{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?__route=:path*"
    },
    {
      "source": "/((?!api/|api$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "{packages/**,frontend/public/data/nigeria/**,backend/platform/**,backend/api/**}"
    },
    "api/cron/recovery.ts": {
      "maxDuration": 300,
      "includeFiles": "{packages/**,backend/platform/**,backend/api/**}"
    }
  }
}
